menuconfig APP_MODEM_AT
	bool "Modem AT handler (shared DLCI 3)"
	default y
	depends on MODEM_CELLULAR
	select MODEM_AT_USER_PIPE
	help
	  Shared AT request/response API over the modem's host pipe (DLCI 3).

if APP_MODEM_AT

config APP_MODEM_AT_SHELL
	bool "at shell command"
	default y if SHELL
	help
	  Re-adds the interactive `at "<command>"` shell on top of the shared
	  handler.

config APP_MODEM_AT_COMMAND_MAX_SIZE
	int "Maximum AT command length"
	default 256

config APP_MODEM_AT_RESPONSE_MAX_SIZE
	int "Maximum collected AT response size"
	default 1024

config APP_MODEM_AT_CHAT_RECEIVE_BUF_SIZE
	int "Chat receive buffer size"
	default 1024
	help
	  Must hold the longest single response line plus the longest match.

config APP_MODEM_AT_TIMEOUT_SECONDS
	int "Default AT command timeout (seconds)"
	default 30

config APP_MODEM_AT_PIPE_WAIT_TIMEOUT_SECONDS
	int "Max time to wait for the AT pipe if another module is using it"
	default 60
	help
	  modem_at_run() shares one AT pipe across modules. This bounds how long a
	  call will wait for another module's in-progress command to finish before
	  giving up. Should be at least as long as the slowest AT command timeout
	  among the modules sharing the pipe, so a caller does not give up on a
	  still-legitimate exchange.

module = APP_MODEM_AT
module-str = modem_at
source "subsys/logging/Kconfig.template.log_config"

endif # APP_MODEM_AT
