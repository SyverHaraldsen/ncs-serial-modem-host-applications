menuconfig APP_NETWORK
	bool "Network module"
	default y
	depends on NET_CONNECTION_MANAGER
	help
	  Drives connectivity through conn_mgr / net_mgmt. The cellular modem driver
	  brings the PPP link up, and Wi-Fi connects to stored credentials where the
	  board has it. The first interface to reach L4 becomes the default route; a
	  failing interface is logged without stopping the others.

if APP_NETWORK

config APP_NETWORK_THREAD_STACK_SIZE
	int "Thread stack size"
	default 2048

config APP_NETWORK_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 300

config APP_NETWORK_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 290

config APP_NETWORK_SEARCH_NETWORK_ON_STARTUP
	bool "Connect to network on startup"
	default y

config APP_NETWORK_MODEM_BAUDRATE
	int "Modem UART baud rate override"
	default 0
	depends on MODEM_CELLULAR
	help
	  Applied to the modem's UART before the cellular driver starts. 0 keeps
	  current-speed from devicetree. The nRF UARTE binding does not list
	  3000000, the only nRF93M1 rate above 921600, so it is set here.

config APP_NETWORK_LTE_RECOVERY_SECONDS
	int "LTE recovery timeout"
	default 120
	depends on MODEM_CELLULAR
	help
	  Time LTE gets to come up before the modem is power cycled. Further LTE
	  requests wait until the current one has completed or timed out.

module = APP_NETWORK
module-str = Network
source "subsys/logging/Kconfig.template.log_config"

endif
