 *
 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 *
 * nRF54LM20 DK driving an nRF93M1 DK in modem bypass mode over UARTE00 at 3 Mbaud,
 * with an Arducam Mega on SPI22 (SCK P1.04, MISO P1.05, MOSI P1.06, CS P1.07).
 * Console and shell stay on VCOM0.
 *
 * Set the modem to AT+IPR=3000000 first; it keeps the rate in NVM. Flash the 93M1 DK
 * with modem bypass and disable its VCOM1 in Board Configurator, so nothing else drives
 * the modem UART. The DK's IO runs at 1.8 V to match the modem; the camera needs
 * 3.3 V and goes through a level shifter.
 *
 * UARTE00 runs from the 128 MHz HFPLL; UARTE21 tops out at 1 Mbaud. Its signals only
 * reach dedicated pins: RXD P2.00/P2.07, TXD P2.02/P2.08, CTS P2.04/P2.09,
 * RTS P2.05/P2.10. P2.00-P2.05 belong to the DK's flash.
 *
 *   93M1 DK          54LM20 DK
 *   TX         ->    P2.07  UARTE00 RX
 *   RX         <-    P2.08  UARTE00 TX
 *   RTS        ->    P2.09  UARTE00 CTS
 *   CTS        <-    P2.10  UARTE00 RTS
 *   PKEY       <-    P1.11
 *   RST        <-    P1.10
 *   GND        --    GND
 */

/ {
	chosen {
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
	};
};

&uart30 {
	status = "okay";
	current-speed = <115200>;
};

&pinctrl {
	spi22_default: spi22_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
				<NRF_PSEL(SPIM_MISO, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>;
			bias-pull-down;
		};
	};

	spi22_sleep: spi22_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 4)>,
				<NRF_PSEL(SPIM_MISO, 1, 5)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>;
			bias-pull-down;
			low-power-enable;
		};
	};

};

&gpio1 {
	status = "okay";
};

&spi22 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi22_default>;
	pinctrl-1 = <&spi22_sleep>;
	pinctrl-names = "default", "sleep";
	overrun-character = <0x00>;
	zephyr,pm-device-runtime-auto;
	cs-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;

	arducam_mega: arducam-mega@0 {
		compatible = "nordic,arducam-mega";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

/* Axon NPU for person detection; its buffers need the SRAM TF-M would take. */
&axon {
	status = "okay";
};

&wdt31 {
	status = "okay";
};

/* UARTE00 shares its instance with SPIM00, which drives the DK's external flash (unused). */
&spi00 {
	status = "disabled";
};

/ {
	aliases {
		modem = &modem;
	};
};

&pinctrl {
	uart00_modem_default: uart00_modem_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 8)>,
				<NRF_PSEL(UART_RTS, 2, 10)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 2, 7)>,
				<NRF_PSEL(UART_CTS, 2, 9)>;
			bias-pull-up;
		};
	};

	uart00_modem_sleep: uart00_modem_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 8)>,
				<NRF_PSEL(UART_RX, 2, 7)>,
				<NRF_PSEL(UART_RTS, 2, 10)>,
				<NRF_PSEL(UART_CTS, 2, 9)>;
			low-power-enable;
		};
	};
};

/* The binding has no 3000000; CONFIG_APP_NETWORK_MODEM_BAUDRATE sets it at boot. */
&uart00 {
	status = "okay";
	current-speed = <4000000>;
	pinctrl-0 = <&uart00_modem_default>;
	pinctrl-1 = <&uart00_modem_sleep>;
	pinctrl-names = "default", "sleep";
	hw-flow-control;
	zephyr,pm-device-runtime-auto;

	modem: modem {
		compatible = "nordic,nrf93m1";
		status = "okay";
		/* The module's own active-low pins, driven through a one-way level shifter. */
		mdm-power-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		mdm-reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
		zephyr,pm-device-runtime-auto;
	};
};
